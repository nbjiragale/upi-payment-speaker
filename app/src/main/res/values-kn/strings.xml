    <!-- Onboarding strings -->
    <string name="onboarding_welcome_title">ಪ್ರತಿ UPI ಪಾವತಿಯನ್ನು ಕೇಳಿ</string>
    <string name="onboarding_welcome_body">UPI ಪಾವತಿ ಅಧಿಸೂಚನೆ ಬಂದಾಗ ಈ ಆ್ಯಪ್ ಮೊತ್ತವನ್ನು ಜೋರಾಗಿ ಹೇಳುತ್ತದೆ — ಪರದೆ ಆಫ್ ಆಗಿದ್ದರೂ ಸಹ. ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಇದನ್ನು ವಿಶ್ವಾಸಾರ್ಹವಾಗಿ ಮಾಡಲು ನಮಗೆ ಕೆಲವು ಅನುಮತಿಗಳು ಬೇಕು.</string>
    <string name="onboarding_notif_listener_title">ಅಧಿಸೂಚನೆ\nಪ್ರವೇಶ ಅನುಮತಿಸಿ</string>
    <string name="onboarding_notif_listener_body">ನಿಮ್ಮ UPI ಆ್ಯಪ್‌ಗಳಿಂದ (PhonePe, Google Pay, Paytm) ವ್ಯವಹಾರ ಅಧಿಸೂಚನೆಗಳನ್ನು ಓದಿ ಮೊತ್ತವನ್ನು ಜೋರಾಗಿ ಹೇಳುತ್ತೇವೆ.</string>
    <string name="onboarding_notif_listener_privacy">ನಿಮ್ಮ ಸಾಧನದಿಂದ ಏನೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="onboarding_notif_post_title">ಅಧಿಸೂಚನೆಗಳನ್ನು ಅನುಮತಿಸಿ</string>
    <string name="onboarding_notif_post_body">ಆ್ಯಪ್ ಚಾಲನೆಯಲ್ಲಿರಲು ಸಣ್ಣ ಸ್ಥಿತಿ ಐಕಾನ್ ಟ್ರೇನಲ್ಲಿ ಇರುತ್ತದೆ.</string>
    <string name="onboarding_exact_alarm_title">ನಿಖರ ಅಲಾರ್ಮ್\nಅನುಮತಿಸಿ</string>
    <string name="onboarding_exact_alarm_body">ಲಿಸನರ್ ಇನ್ನೂ ಸಕ್ರಿಯವಾಗಿದೆ ಎಂದು ಪರಿಶೀಲಿಸಲು ನಮ್ಮ ವಾಚ್‌ಡಾಗ್ (ಪ್ರತಿ 30 ನಿಮಿಷ) ಬಳಸುತ್ತದೆ.</string>
    <string name="onboarding_battery_title">ಬ್ಯಾಟರಿ\nಆಪ್ಟಿಮೈಸೇಶನ್ ಆಫ್ ಮಾಡಿ</string>
    <string name="onboarding_battery_body">ನಿಮ್ಮ ಫೋನ್ ಇಲ್ಲದಿದ್ದರೆ ನಮ್ಮನ್ನು ನಿದ್ರೆಗೆ ಹಾಕಿ ವ್ಯವಹಾರಗಳನ್ನು ಮೌನವಾಗಿ ಬಿಡಬಹುದು.</string>
    <string name="onboarding_oem_title">%1$s ಹಿನ್ನೆಲೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು</string>
    <string name="onboarding_oem_body">%1$s ಸಾಮಾನ್ಯ Android ಮೇಲೆ ಹೆಚ್ಚುವರಿ ಹಿನ್ನೆಲೆ ನಿರ್ಬಂಧಗಳನ್ನು ಅನ್ವಯಿಸುತ್ತದೆ. ದಯವಿಟ್ಟು ಆಟೋಸ್ಟಾರ್ಟ್ ಸಕ್ರಿಯಗೊಳಿಸಿ ಮತ್ತು ಈ ಆ್ಯಪ್ ಅನ್ನು ಅನಿಯಂತ್ರಿತ ಬ್ಯಾಟರಿ ಪಟ್ಟಿಗೆ ಸೇರಿಸಿ — ಇದಿಲ್ಲದೆ, ಘೋಷಣೆಗಳು ತಪ್ಪಬಹುದು.</string>
    <string name="onboarding_vivo_extra_title">Vivo: ಹೆಚ್ಚುವರಿ ಹಂತಗಳು</string>
    <string name="onboarding_vivo_extra_body">1. ರೀಸೆಂಟ್ಸ್ ಸ್ಕ್ರೀನ್ ತೆರೆಯಿರಿ, ಈ ಆ್ಯಪ್ ಮೇಲೆ ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ, ಮತ್ತು iManager ಅದನ್ನು ಸ್ವೀಪ್ ಮಾಡದಂತೆ ಲಾಕ್ ಐಕಾನ್ ಟ್ಯಾಪ್ ಮಾಡಿ.\n\n2. ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಬ್ಯಾಟರಿ → ಹಿನ್ನೆಲೆ ವಿದ್ಯುತ್ ಬಳಕೆ ನಿರ್ವಹಣೆ → ಈ ಆ್ಯಪ್ ಅನ್ನು \"ಹಿನ್ನೆಲೆ ಹೆಚ್ಚಿನ ವಿದ್ಯುತ್ ಬಳಕೆ ಅನುಮತಿಸಿ\" ಎಂದು ಹೊಂದಿಸಿ.</string>
    <string name="onboarding_test_title">ಪರೀಕ್ಷಾ\nಘೋಷಣೆ ಮಾಡಿ</string>
    <string name="onboarding_test_body">ಕೆಳಗಿನ ಬಟನ್ ಟ್ಯಾಪ್ ಮಾಡಿ — ನೀವು \"ಪರೀಕ್ಷೆ: ಇನ್ನೂರ ಐವತ್ತು ರೂಪಾಯಿ ಬಂದಿದೆ\" ಎಂದು ಕೇಳಬೇಕು. ಇದು ಸಿಸ್ಟಮ್‌ಗೆ ನಮ್ಮ ಆಡಿಯೋ ಸೇವೆಯನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.</string>
