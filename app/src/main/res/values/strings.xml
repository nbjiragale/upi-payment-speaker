    <!-- Onboarding strings -->
    <string name="onboarding_welcome_title">Hear every UPI payment</string>
    <string name="onboarding_welcome_body">This app speaks the amount aloud whenever a UPI payment notification arrives — even when the screen is off. To make this reliable on your phone we need a few permissions.</string>
    <string name="onboarding_notif_listener_title">Allow notification\naccess</string>
    <string name="onboarding_notif_listener_body">We read transaction notifications from your UPI apps (PhonePe, Google Pay, Paytm) and speak the amount out loud.</string>
    <string name="onboarding_notif_listener_privacy">Nothing is sent off your device.</string>
    <string name="onboarding_notif_post_title">Allow notifications</string>
    <string name="onboarding_notif_post_body">A small status icon stays in the tray so the app keeps running.</string>
    <string name="onboarding_exact_alarm_title">Allow exact alarms</string>
    <string name="onboarding_exact_alarm_body">Used by our watchdog (every 30 minutes) to verify the listener is still active.</string>
    <string name="onboarding_battery_title">Disable battery\noptimisation</string>
    <string name="onboarding_battery_body">Your phone may otherwise put us to sleep and silently drop transactions.</string>
    <string name="onboarding_oem_title">%1$s background settings</string>
    <string name="onboarding_oem_body">%1$s applies extra background restrictions on top of standard Android. Please enable Autostart and add this app to the unrestricted battery list — without this, announcements will be missed.</string>
    <string name="onboarding_vivo_extra_title">Vivo: extra steps</string>
    <string name="onboarding_vivo_extra_body">1. Open the Recents screen, swipe down on this app, and tap the lock icon so iManager won\'t sweep it.\n\n2. Settings → Battery → Background power consumption management → set this app to "Allow background high power consumption".</string>
    <string name="onboarding_test_title">Make a test\nannouncement</string>
    <string name="onboarding_test_body">Tap the button below — you should hear "Test: two hundred and fifty rupees received". This also helps the system remember our audio service so it survives Doze.</string>
