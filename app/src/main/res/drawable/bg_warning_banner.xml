<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/warn_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="@color/warn" />
            <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp"
                android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
